:root{
  --bg:#03050c; --bg2:#070b18; --panel:rgba(10,16,34,.72); --line:rgba(120,170,255,.16);
  --txt:#e8eefc; --mut:#8b98b8; --cyan:#38e1ff; --blue:#5b7cff; --violet:#a86bff;
  --orange:#ff8a3d; --red:#ff4d5e; --amber:#ffb020; --green:#3dff9a;
  --r:16px; --mono:'JetBrains Mono',monospace; --head:'Space Grotesk',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--txt);font-family:Inter,system-ui,sans-serif;line-height:1.6;overflow-x:hidden}
a{color:var(--cyan);text-decoration:none}
h1,h2,h3,h4{font-family:var(--head);line-height:1.12;letter-spacing:-.01em}
h2{font-size:clamp(1.9rem,4vw,3rem);margin-bottom:1.2rem}
h3{font-size:1.15rem;margin-bottom:.4rem}
.muted{color:var(--mut)} .small{font-size:.85rem} .center{text-align:center;margin-top:2rem}
.grad{background:linear-gradient(90deg,var(--cyan),var(--blue) 50%,var(--violet));-webkit-background-clip:text;background-clip:text;color:transparent}
.grad-warn{background:linear-gradient(90deg,var(--amber),var(--red));-webkit-background-clip:text;background-clip:text;color:transparent}
.wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.kicker{font-family:var(--mono);font-size:.8rem;color:var(--cyan);letter-spacing:.18em;text-transform:uppercase;margin-bottom:.8rem}
.kicker.glow{text-shadow:0 0 18px var(--cyan)}

/* nav */
.nav{position:fixed;inset:0 0 auto 0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:14px 28px;background:linear-gradient(180deg,rgba(3,5,12,.9),rgba(3,5,12,0));backdrop-filter:blur(6px)}
.brand{font-family:var(--head);font-weight:700;color:#fff;letter-spacing:.12em;display:flex;align-items:center;gap:10px}
.brand b{color:var(--cyan)}
.brand-mark{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,var(--cyan),var(--violet));color:#03050c}
.nav-links{display:flex;gap:6px;align-items:center}
.nav-links a{color:var(--mut);padding:8px 12px;border-radius:10px;font-size:.92rem;transition:.2s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.05)}
.nav-cta{color:#03050c!important;background:var(--cyan);font-weight:600;box-shadow:0 0 24px rgba(56,225,255,.45)}
@media(max-width:860px){.nav-links a:not(.nav-cta){display:none}}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;border-radius:12px;font-weight:600;font-family:inherit;font-size:.95rem;border:1px solid transparent;cursor:pointer;transition:.2s;color:var(--txt);background:none}
.btn-primary{background:linear-gradient(135deg,var(--cyan),var(--blue));color:#02040b;box-shadow:0 6px 30px rgba(56,225,255,.35)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 40px rgba(56,225,255,.55)}
.btn-primary:disabled{opacity:.4;cursor:not-allowed;transform:none}
.btn-ghost{border-color:var(--line);background:rgba(255,255,255,.03)}
.btn-ghost:hover{border-color:var(--cyan);color:var(--cyan)}
.btn-sm{padding:8px 14px;font-size:.85rem;border-radius:10px}
.btn.wide{width:100%}
.icon-btn{width:36px;height:36px;border-radius:10px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--txt);cursor:pointer;display:grid;place-items:center;flex:none}
.icon-btn:hover{border-color:var(--cyan);color:var(--cyan)}

/* hero */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;background:radial-gradient(1200px 700px at 75% 50%,rgba(40,80,200,.18),transparent 60%),var(--bg)}
#hero-canvas{position:absolute;inset:0;width:100%;height:100%}
.hero-inner{position:relative;z-index:2;max-width:1240px;margin:0 auto;padding:120px 24px 80px;width:100%;pointer-events:none}
.hero-inner>*{pointer-events:auto;max-width:620px}
.eyebrow{font-family:var(--mono);font-size:.8rem;color:var(--mut);letter-spacing:.15em;text-transform:uppercase;display:flex;align-items:center;gap:10px;margin-bottom:1.2rem}
.dot-live{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green);animation:pulse 1.6s infinite}
@keyframes pulse{50%{opacity:.3}}
.hero h1{font-size:clamp(2.4rem,6vw,4.6rem);margin-bottom:1.4rem;text-shadow:0 4px 40px rgba(0,0,0,.8)}
.lead{font-size:1.1rem;color:#c3cde6;margin-bottom:2rem;text-shadow:0 2px 20px #000}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:3rem}
.hero-stats{display:flex;gap:36px;flex-wrap:wrap}
.hero-stats b{font-family:var(--head);font-size:2rem;display:block;color:#fff}
.hero-stats small{font-size:1rem;color:var(--mut)}
.hero-stats span{font-size:.8rem;color:var(--mut);text-transform:uppercase;letter-spacing:.1em}
.scroll-hint{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);color:var(--mut);animation:bob 2s infinite;z-index:2}
@keyframes bob{50%{transform:translate(-50%,8px)}}
@media(max-width:800px){.hero{align-items:flex-start}.hero-inner{padding-top:100px}}

/* sections */
.section{padding:110px 0;position:relative}
.section.alt{background:linear-gradient(180deg,var(--bg),var(--bg2) 30%,var(--bg2) 70%,var(--bg))}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:26px;backdrop-filter:blur(8px);transition:transform .3s,border-color .3s,box-shadow .3s}
.card:hover{transform:translateY(-6px);border-color:rgba(56,225,255,.4);box-shadow:0 20px 60px rgba(0,0,0,.4),0 0 0 1px rgba(56,225,255,.1) inset}
.card p{color:var(--mut);font-size:.95rem}
.ic{font-size:1.6rem;margin-bottom:14px;color:var(--cyan);display:inline-block}
.ic.warn{color:var(--amber)}
.problem-grid,.feat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin-top:2rem}
.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s,transform .8s}
.reveal.in{opacity:1;transform:none}

/* solution */
.split{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center}
@media(max-width:900px){.split{grid-template-columns:1fr}}
.sol-list{list-style:none;display:grid;gap:14px;margin-top:1.6rem}
.sol-list li{display:flex;gap:16px;align-items:flex-start;padding:16px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.02)}
.sol-list i{color:var(--cyan);font-size:1.2rem;margin-top:3px;width:24px;text-align:center}
.sol-list div{color:var(--mut)} .sol-list b{color:#fff}
.sol-visual{display:grid;place-items:center;perspective:900px}
.orbit-rings{position:relative;width:min(420px,80vw);aspect-ratio:1;transform:rotateX(62deg) rotateZ(10deg);transform-style:preserve-3d}
.orbit-rings .r{position:absolute;inset:0;border-radius:50%;border:1px solid rgba(56,225,255,.35);box-shadow:0 0 30px rgba(56,225,255,.12) inset}
.orbit-rings .r2{inset:12%;border-color:rgba(168,107,255,.35)} .orbit-rings .r3{inset:24%;border-color:rgba(255,138,61,.35)}
.orbit-rings .planet{position:absolute;inset:36%;border-radius:50%;background:radial-gradient(circle at 35% 35%,#6fc3ff,#1a3b8f 55%,#050a20);box-shadow:0 0 60px rgba(56,140,255,.5);transform:rotateX(-62deg)}
.orbit-rings .s{position:absolute;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 0 16px var(--cyan);top:50%;left:50%;margin:-6px}
.s1{animation:orb1 6s linear infinite}.s2{animation:orb2 9s linear infinite}.s3{animation:orb3 4.5s linear infinite}
.s.danger{background:var(--red);box-shadow:0 0 18px var(--red)}
@keyframes orb1{from{transform:rotate(0) translateX(210px)}to{transform:rotate(360deg) translateX(210px)}}
@keyframes orb2{from{transform:rotate(90deg) translateX(160px)}to{transform:rotate(450deg) translateX(160px)}}
@keyframes orb3{from{transform:rotate(200deg) translateX(110px)}to{transform:rotate(-160deg) translateX(110px)}}

/* flow */
.flow{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;margin-top:2.4rem;position:relative}
.flow::before{content:"";position:absolute;top:44px;left:6%;right:6%;height:2px;background:linear-gradient(90deg,var(--cyan),var(--violet),var(--orange),var(--red),var(--green));opacity:.6}
.flow-node{position:relative;text-align:center;padding:20px 12px;border-radius:16px;background:var(--panel);border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;gap:6px}
.flow-node span{position:absolute;top:-10px;left:12px;font-family:var(--mono);font-size:.72rem;color:var(--cyan)}
.flow-node i{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:#0a1430;border:1px solid var(--cyan);color:var(--cyan);font-size:1.2rem;box-shadow:0 0 20px rgba(56,225,255,.3);position:relative;z-index:1}
.flow-node b{font-family:var(--head);font-size:.98rem}
.flow-node small{color:var(--mut);font-size:.8rem}
@media(max-width:980px){.flow{grid-template-columns:repeat(2,1fr)}.flow::before{display:none}}

/* ======================== LAB ======================== */
.lab-section{padding:110px 0 80px;background:radial-gradient(900px 500px at 50% 0,rgba(56,225,255,.08),transparent 70%),var(--bg);border-top:1px solid var(--line);border-bottom:1px solid var(--line);position:relative}
.lab-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:24px}
.lab-head>div:first-child{max-width:680px}
.mode-switch{display:flex;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:14px;padding:4px}
.mode-btn{border:0;background:none;color:var(--mut);padding:10px 16px;border-radius:10px;cursor:pointer;font-family:inherit;font-weight:600;font-size:.9rem;display:flex;gap:8px;align-items:center}
.mode-btn.active{background:linear-gradient(135deg,var(--cyan),var(--blue));color:#02040b}
.lab{max-width:1500px;margin:0 auto;padding:0 18px}
.viewport{position:relative;height:min(82vh,820px);min-height:560px;border-radius:22px;overflow:hidden;border:1px solid rgba(56,225,255,.25);background:#000;box-shadow:0 0 0 1px rgba(56,225,255,.06),0 30px 120px rgba(56,225,255,.12),inset 0 0 120px rgba(0,0,0,.8)}
.viewport::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.012) 0 1px,transparent 1px 3px);border-radius:inherit}
#lab-canvas{width:100%;height:100%;display:block;cursor:grab}
#lab-canvas:active{cursor:grabbing}
.labels{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.lbl{position:absolute;transform:translate(-50%,-140%);font-family:var(--mono);font-size:.7rem;white-space:nowrap;padding:3px 8px;border-radius:6px;background:rgba(3,6,16,.78);border:1px solid var(--line);color:#fff}
.lbl.target{border-color:#fff;box-shadow:0 0 12px rgba(255,255,255,.3)}
.lbl.threat{border-color:var(--red);color:#ffd0d4}
.lbl.info{border-color:var(--cyan);color:var(--cyan)}
.lbl.green{border-color:var(--green);color:var(--green)}
.lbl.big{font-size:.8rem;padding:5px 10px}

.hud{position:absolute;top:16px;z-index:5;display:flex;flex-direction:column;gap:12px;max-height:calc(100% - 100px)}
.hud-left{left:16px;width:360px}
.hud-right{right:16px;width:330px}
.steps{list-style:none;display:flex;gap:4px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:6px;backdrop-filter:blur(10px)}
.steps li{flex:1;text-align:center;font-size:.68rem;color:var(--mut);padding:6px 2px;border-radius:9px;cursor:pointer;font-family:var(--mono);text-transform:uppercase;transition:.2s}
.steps li span{display:block;font-size:.95rem;font-weight:600;font-family:var(--head)}
.steps li.done{color:var(--cyan)}
.steps li.active{background:linear-gradient(135deg,rgba(56,225,255,.25),rgba(91,124,255,.25));color:#fff;box-shadow:0 0 0 1px var(--cyan) inset}
.explain{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px;backdrop-filter:blur(12px);overflow:auto}
.ex-kicker{font-family:var(--mono);font-size:.7rem;color:var(--cyan);letter-spacing:.15em}
.explain h3{font-size:1.25rem;margin:.3rem 0 .6rem}
.explain p{font-size:.88rem;color:#b9c4de}
.explain p b{color:#fff}
.ex-3d{margin-top:10px;display:grid;gap:6px}
.ex-3d .k{display:flex;justify-content:space-between;font-family:var(--mono);font-size:.76rem;padding:6px 10px;border-radius:8px;background:rgba(255,255,255,.03);border:1px solid var(--line)}
.ex-3d .k b{color:var(--cyan)}
.ex-3d .k.warn b{color:var(--red)} .ex-3d .k.ok b{color:var(--green)} .ex-3d .k.amb b{color:var(--amber)}
.ex-formula{margin-top:10px;font-family:var(--mono);font-size:.74rem;color:var(--violet);background:rgba(168,107,255,.07);border:1px dashed rgba(168,107,255,.35);padding:8px 10px;border-radius:8px;white-space:pre-wrap}
.ex-formula:empty{display:none}
.ex-actions{display:flex;justify-content:space-between;gap:8px;margin-top:14px}
.ex-actions .btn-primary{flex:1}
.lab.explore .hud-left .explain{display:none}
.lab.explore .steps{display:none}

.console{background:rgba(2,5,12,.85);border:1px solid var(--line);border-radius:14px;overflow:hidden;backdrop-filter:blur(10px)}
.console-head{display:flex;align-items:center;gap:8px;padding:8px 12px;font-family:var(--mono);font-size:.72rem;color:var(--mut);border-bottom:1px solid var(--line)}
.dots{display:flex;gap:5px}.dots i{width:8px;height:8px;border-radius:50%;background:#333}
.dots i:nth-child(1){background:#ff5f57}.dots i:nth-child(2){background:#febc2e}.dots i:nth-child(3){background:#28c840}
.src-badge{margin-left:auto;padding:2px 8px;border-radius:20px;background:#333;color:#ccc;text-transform:uppercase;font-size:.62rem;letter-spacing:.1em}
.src-badge.live{background:rgba(61,255,154,.15);color:var(--green)}
.src-badge.cache{background:rgba(56,225,255,.15);color:var(--cyan)}
.src-badge.simulated{background:rgba(255,176,32,.15);color:var(--amber)}
.console-body{height:190px;overflow:auto;padding:10px 12px;font-family:var(--mono);font-size:.7rem;line-height:1.55}
.console-body div{white-space:pre-wrap;word-break:break-all}
.c-cmd{color:var(--cyan)} .c-ok{color:var(--green)} .c-warn{color:var(--amber)} .c-err{color:var(--red)} .c-dim{color:#6b7896}
.inspector{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;backdrop-filter:blur(10px)}
.insp-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:8px}
.insp-head b{font-family:var(--head);font-size:1rem}
.insp-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px}
.insp-grid div{font-family:var(--mono);font-size:.7rem;background:rgba(255,255,255,.03);border-radius:8px;padding:6px 8px}
.insp-grid div span{display:block;color:var(--mut);font-size:.62rem;text-transform:uppercase}
.insp-grid .tle{grid-column:1/-1;font-size:.6rem;color:#8fa;word-break:break-all}

.hud-center{position:absolute;left:50%;top:16px;transform:translateX(-50%);z-index:5;background:rgba(40,4,10,.8);border:1px solid var(--red);color:#ffd6da;padding:8px 16px;border-radius:12px;font-family:var(--mono);font-size:.78rem;box-shadow:0 0 30px rgba(255,77,94,.35);animation:alarm 1.4s infinite}
.hud-center.ok{background:rgba(4,40,20,.8);border-color:var(--green);color:#c9ffe1;box-shadow:0 0 30px rgba(61,255,154,.3);animation:none}
@keyframes alarm{50%{box-shadow:0 0 6px rgba(255,77,94,.2)}}

.timeline{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);z-index:6;display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--line);padding:8px 12px;border-radius:14px;backdrop-filter:blur(10px);width:min(640px,calc(100% - 32px))}
.time-read{display:flex;flex-direction:column;line-height:1.1;min-width:92px}
.time-read b{font-family:var(--mono);font-size:.95rem}
.time-read small{font-family:var(--mono);font-size:.62rem;color:var(--mut)}
#scrub{flex:1;accent-color:var(--cyan)}
.timeline select,.deck select{background:#0a1124;color:var(--txt);border:1px solid var(--line);border-radius:8px;padding:6px 8px;font-family:inherit}
.legend{position:absolute;right:16px;bottom:20px;z-index:4;display:flex;flex-direction:column;gap:3px;font-size:.68rem;color:var(--mut);font-family:var(--mono);background:rgba(3,6,16,.6);padding:8px 10px;border-radius:10px;border:1px solid var(--line)}
.legend i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;box-shadow:0 0 6px currentColor}

.boot{position:absolute;inset:0;z-index:20;display:grid;place-items:center;background:radial-gradient(circle,rgba(3,8,20,.55),rgba(0,0,0,.85))}
.boot.hide{opacity:0;pointer-events:none;transition:opacity .8s}
.boot-card{text-align:center;max-width:380px;padding:30px;background:var(--panel);border:1px solid rgba(56,225,255,.35);border-radius:20px;backdrop-filter:blur(12px)}
.boot-card h3{font-size:1.4rem;margin:14px 0 6px}
.boot-card p{color:var(--mut);font-size:.92rem;margin-bottom:18px}
.boot-card small{display:block;color:#5f6c8c;font-size:.72rem;margin-top:12px}
.radar{width:90px;height:90px;margin:0 auto;border-radius:50%;border:1px solid var(--cyan);position:relative;overflow:hidden;background:repeating-radial-gradient(circle,transparent 0 14px,rgba(56,225,255,.2) 15px)}
.radar span{position:absolute;inset:0;background:conic-gradient(from 0deg,rgba(56,225,255,.6),transparent 25%);animation:spin 2s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* deck */
.deck{display:grid;grid-template-columns:1fr 1.15fr 1.25fr;gap:16px;margin-top:16px}
@media(max-width:1100px){.deck{grid-template-columns:1fr}}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;min-width:0}
.panel h4{font-size:.95rem;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.panel h4 i{color:var(--cyan)} .panel h4 small{margin-left:auto;font-family:var(--mono);font-weight:400;color:var(--mut);font-size:.7rem}
.panel label{display:flex;flex-direction:column;gap:6px;font-size:.78rem;color:var(--mut);margin-bottom:12px}
.panel label output{font-family:var(--mono);color:var(--cyan);margin-left:6px;display:inline}
.panel input[type=range]{accent-color:var(--cyan)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.check{flex-direction:row!important;align-items:center}
.catalogs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.cat{font-family:var(--mono);font-size:.66rem;padding:4px 8px;border-radius:20px;border:1px solid var(--line);color:var(--mut)}
.cat b{color:#fff}
.cat.live{border-color:rgba(61,255,154,.4)} .cat.cache{border-color:rgba(56,225,255,.4)} .cat.simulated{border-color:rgba(255,176,32,.4)}
.conj-list{display:flex;flex-direction:column;gap:6px;max-height:330px;overflow:auto}
.conj{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:10px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.02);cursor:pointer;text-align:left;color:inherit;font-family:inherit;width:100%}
.conj:hover,.conj.sel{border-color:var(--cyan);background:rgba(56,225,255,.06)}
.conj .badge{font-family:var(--mono);font-size:.62rem;font-weight:600;padding:3px 7px;border-radius:6px;color:#000}
.conj .nm{font-size:.82rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.conj .meta{font-family:var(--mono);font-size:.66rem;color:var(--mut)}
.conj .dist{font-family:var(--mono);font-size:.9rem;font-weight:600;text-align:right}
.conj .dist small{display:block;font-size:.6rem;color:var(--mut);font-weight:400}
.empty{color:var(--mut);font-size:.85rem;padding:12px 0}
.chart-box{position:relative;height:170px}
.mitig{margin-top:12px}
.mitig .mgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:10px 0}
.mitig .mgrid div{font-family:var(--mono);font-size:.74rem;background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:10px;padding:8px}
.mitig .mgrid span{display:block;font-size:.6rem;color:var(--mut);text-transform:uppercase}
.mitig .mgrid b{font-size:.9rem}
.verdict{font-size:.82rem;padding:10px;border-radius:10px;margin-top:8px}
.verdict.ok{background:rgba(61,255,154,.08);border:1px solid rgba(61,255,154,.35);color:#bfffdc}
.verdict.bad{background:rgba(255,77,94,.08);border:1px solid rgba(255,77,94,.35);color:#ffc9cf}

@media(max-width:900px){
  .viewport{height:auto;min-height:0;display:flex;flex-direction:column}
  #lab-canvas{height:62vh;min-height:420px}
  .labels{bottom:auto;height:62vh}
  .hud{position:static;width:auto;max-height:none;padding:10px}
  .hud-left{order:2}.hud-right{order:3}
  .timeline{top:calc(62vh - 66px);bottom:auto}
  .legend{display:none}
  .hud-center{top:12px;font-size:.68rem;white-space:nowrap;max-width:calc(100% - 24px);overflow:hidden;text-overflow:ellipsis}
  .hud-left .steps li{font-size:.6rem}
  .boot{position:absolute}
  .lab-head{flex-direction:column;align-items:flex-start}
}

/* stack */
.stack-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:2rem}
@media(max-width:760px){.stack-grid{grid-template-columns:1fr}}
.stack-col{padding:26px;border-radius:var(--r);border:1px solid var(--line);background:var(--panel)}
.stack-col h3 i{color:var(--cyan);margin-right:8px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.chips span{font-family:var(--mono);font-size:.8rem;padding:6px 12px;border-radius:20px;border:1px solid rgba(56,225,255,.3);background:rgba(56,225,255,.06)}
.footer{padding:40px 24px;text-align:center;border-top:1px solid var(--line)}
.footer p{margin-bottom:6px}
